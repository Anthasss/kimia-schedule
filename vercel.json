{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build --config client/vite.config.ts",
  "outputDirectory": "client/dist",
  "fluid": true,
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!assets/).*)", "destination": "/" }
  ]
}
